# ====================================================================
# 招新项目 Git 忽略规则
# 目标：仅在 GitHub 上保留成品程序（Viewer）、项目源码与题目说明
# ====================================================================

# ---------- 内部维护与参考资料 (不对新生公开) ----------
maintainer/
reference/
project/.server_and_tracking/

# ---------- 临时测试与诊断文件 ----------
partition_readback.bin
*.bin
url.txt
*.png

# ---------- 隐藏文件与配置 (除 .gitignore 外) ----------
.*
!.gitignore
!.gitattributes
!.github/
!.github/workflows/
!.github/workflows/camera-viewer-release.yml

# ---------- 构建产物与编译缓存 ----------
# Arduino / PlatformIO / ESP-IDF 构建缓存
build/
**/build/
.pio/
.codex-build*
.flash-diagnostics/
dist/
out/
bin/
obj/

# 编译中间文件与固件镜像 (避免本地编译产物被提交)
*.o
*.d
*.a
*.elf
*.hex
*.map
*.i
*.s

# ---------- 可执行文件与动态库 ----------
# 忽略常规 exe/dll，但保留项目 tools 下自带的成品查看器
*.exe
*.dll
!project/CameraWebServer/tools/CameraStreamViewer.exe
!project/CameraWebServer_for_fr/tools/CameraStreamViewer.exe

# ---------- Python 缓存与虚拟环境 ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# ---------- IDE 与编辑器配置 ----------
.vscode/
.vs/
.idea/
*.user
*.suo
*.workspace
*.code-workspace

# ---------- 系统与临时日志文件 ----------
*.log
*.tmp
*.temp
*.swp
*.bak
*.swo
*~
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
